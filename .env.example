# Ghidra 12.1.3 and JDK 21 are the validated combination.
GHIDRA_INSTALL_DIR=/opt/ghidra
JAVA_HOME=/opt/java/openjdk
# Ghidra project paths must not contain dot-prefixed directory names.
GHIDRAMA_DATA_DIR=data
# Optional limits; see README for the full configuration.
GHIDRAMA_MAX_UPLOAD_MB=50
GHIDRAMA_PORT=8000
